# 本地开发默认使用 SQLite
DB_TYPE=sqlite
DATABASE_URL=sqlite:///./smart.db

# 使用 MySQL时，清空 DATABASE_URL 并启用以下配置
# DB_TYPE=mysql
# DATABASE_URL=
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_DATABASE=smart_maintenance
# MYSQL_USER=smart_maintenance
# MYSQL_PASSWORD=请填写高强度密码

# 阿里云百炼北京地域实时推理（不要把真实密钥提交到 GitHub）
MODEL_PROVIDER=aliyun
MODEL_API_KEY=
MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_NAME=qwen-max
MODEL_FALLBACK_NAME=qwen3.7-plus
MODEL_TIMEOUT_SECONDS=20
MODEL_MAX_RETRIES=1
VISION_MODEL_NAME=qwen3.7-plus
VISION_TIMEOUT_SECONDS=15
VISION_MAX_RETRIES=1

# 文本向量 + 关键词混合检索。API不可用时自动退回本地语义向量。
EMBEDDING_ENABLED=true
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=256
EMBEDDING_TIMEOUT_SECONDS=8
EMBEDDING_MAX_CANDIDATES=20

# 认证安全配置（生产环境必须替换 SECRET_KEY）
SECRET_KEY=请替换为至少32位随机字符串
TOKEN_EXPIRE_HOURS=8
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCK_MINUTES=10
ALLOW_PUBLIC_REGISTRATION=true
